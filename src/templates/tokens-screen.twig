{# ========================================================================= #}
{# MCP-tokens — fane på brukersiden                                          #}
{#                                                                           #}
{# Rekkefølgen er flyten, og følger Laravel-varianten av samme skjerm:       #}
{#   1. Tilgang (bare admin på andres fane)                                  #}
{#   2. Opprett nytt token — viker for klarteksten rett etter opprettelse    #}
{#   3. Klarteksten, nøyaktig én gang (session-flash; bare hashen lagres)    #}
{#   4. «Koble til din egen AI» — oppskrifter, lukket til vanlig             #}
{#   5. Tokenlista                                                           #}
{#                                                                           #}
{# Tokenet sendes som header, ikke i URL-en. `/<routePath>/t/<token>` virker #}
{# fortsatt når `tokenInPath` er på, men vises ikke her: en URL med tokenet  #}
{# i havner i serverlogger og nettleserhistorikk, og Claude Desktop kan nå   #}
{# sende egne headere.                                                       #}
{# ========================================================================= #}

{% import '_includes/forms.twig' as forms %}

{% set hasAccess = accessSource is not null %}
{% set token = newToken ?? '<token>' %}

{# Oppskriftene: én liste med felter per klient. Felter kopieres hver for
   seg, fordi Claude Desktop har URL og header i separate inputfelter.
   ChatGPT står i lista, gjennomstreket og uten felter, i stedet for som en
   fotnote under alle de andre: den som leter etter ChatGPT skal finne
   svaret der hen leter. #}
{% set recipes = {
    desktop: {
        label: 'Claude Desktop',
        help: 'Innstillinger → Connectors → Add custom connector. Gi den navnet «' ~ serverName ~ '», velg «No sign-in», og legg til én header under «Request headers». Samme oppsett virker i claude.ai.',
        fields: [
            { label: 'URL', value: mcpUrl },
            { label: 'Header-navn', value: 'authorization' },
            { label: 'Header-verdi', value: 'Bearer ' ~ token },
        ],
    },
    code: {
        label: 'Claude Code',
        help: 'Kjør denne i terminalen.',
        fields: [
            { label: 'Kommando', value: 'claude mcp add --transport http ' ~ serverSlug ~ ' ' ~ mcpUrl ~ ' --header "Authorization: Bearer ' ~ token ~ '"' },
        ],
    },
    copilot: {
        label: 'Copilot',
        help: 'Samme mcp.json gjelder VS Code, Visual Studio, JetBrains og Xcode. Bruk brukerkonfigurasjonen («MCP: Open User Configuration» i VS Code), ikke .vscode/mcp.json i prosjektet — den havner i versjonskontroll, og tokenet er personlig.',
        fields: [
            { label: 'Konfigurasjon', value: { servers: { (serverSlug): { type: 'http', url: mcpUrl, headers: { Authorization: 'Bearer ' ~ token } } } }|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) },
        ],
    },
    codex: {
        label: 'Codex',
        help: 'Legg dette inn i ~/.codex/config.toml.',
        fields: [
            { label: 'Konfigurasjon', value: '[mcp_servers.' ~ serverSlug ~ "]\nurl = \"" ~ mcpUrl ~ "\"\nhttp_headers = { Authorization = \"Bearer " ~ token ~ '" }' },
        ],
    },
    gemini: {
        label: 'Gemini',
        help: 'Kjør denne i terminalen. «-s user» legger serveren i ~/.gemini/settings.json, så den gjelder alle prosjekter.',
        fields: [
            { label: 'Kommando', value: 'gemini mcp add -s user --transport http --header "Authorization: Bearer ' ~ token ~ '" ' ~ serverSlug ~ ' ' ~ mcpUrl },
        ],
    },
    chatgpt: {
        label: 'ChatGPT',
        unavailable: true,
        help: 'ChatGPT sine tilpassede connectors krever i dag OAuth i stedet for et enkelt bearer-token. Denne serveren støtter ikke det, så ChatGPT kan ikke kobles til ennå.',
        fields: [],
    },
} %}

{# ---- 1. Tilgang ---------------------------------------------------------- #}
{% if not isCurrentUser and currentUser.admin %}
    <div class="pane mcp-access">
        {% if accessSource == 'admin' %}
            <p><strong>Har MCP-tilgang</strong> via admin-rollen. Den kan ikke skrus av her.</p>
        {% elseif accessSource == 'group' %}
            <p><strong>Har MCP-tilgang</strong> via en brukergruppe. Fjern permissionen «Tilgang til MCP» fra gruppen, eller ta brukeren ut av den, for å skru den av.</p>
        {% elseif canManageAccess %}
            <form method="post" accept-charset="UTF-8" class="mcp-access-form">
                {{ csrfInput() }}
                {{ actionInput(moduleId ~ '/tokens/set-access') }}
                {{ hiddenInput('userId', user.id) }}
                {{ hiddenInput('enabled', hasAccess ? '0' : '1') }}
                <div>
                    <strong>Kan bruke MCP</strong>
                    <p class="light">Lar brukeren lage tokens for AI-verktøy. Et token kan det samme som brukeren kan i Craft.
                        {% if hasAccess %}Skrus tilgangen av, trekkes alle tokenene til brukeren tilbake.{% endif %}</p>
                </div>
                <button type="submit" class="btn{{ hasAccess ? '' : ' submit' }}">{{ hasAccess ? 'Fjern tilgang' : 'Gi tilgang' }}</button>
            </form>
        {% else %}
            <p>Brukeren har ikke MCP-tilgang. Den gis med permissionen «Tilgang til MCP».</p>
        {% endif %}
    </div>
{% endif %}

{# ---- 2. Opprett nytt token ----------------------------------------------- #}
{# Viker for klarteksten: rett etter opprettelse er jobben å få tokenet trygt
   ut av skjermen, ikke å lage enda et. #}
{% if isCurrentUser and hasAccess and not newToken %}
    <h2>Opprett nytt token</h2>
    <form method="post" accept-charset="UTF-8" class="pane mcp-create">
        {{ csrfInput() }}
        {{ actionInput(moduleId ~ '/tokens/create') }}
        {{ hiddenInput('userId', user.id) }}

        {{ forms.textField({
            label: 'Navn',
            instructions: 'Hvilken maskin eller klient tokenet skal brukes fra.',
            id: 'mcp-token-name',
            name: 'name',
            placeholder: 'Claude Desktop',
            maxlength: 40,
            required: true,
        }) }}

        {{ forms.selectField({
            label: 'Gyldighet',
            instructions: 'Tokenet slutter å virke etter dette.',
            id: 'mcp-token-expires',
            name: 'expiresDays',
            options: expiryOptions,
            value: expiryDefault,
            required: true,
        }) }}

        <div class="field">
            <button type="submit" class="btn submit">Opprett</button>
        </div>
    </form>
{% endif %}

{# ---- 3. Klarteksten ------------------------------------------------------ #}
{% if newToken %}
    <div class="pane mcp-new-token">
        <h2>Ditt nye token</h2>
        <p class="warning with-icon">Av sikkerhetshensyn vises tokenet bare én gang. Oppskriftene under er ferdig utfylt med det.</p>
        {% include '_includes/forms/copytext.twig' with {
            id: 'mcp-new-token',
            value: newToken,
            class: 'code fullwidth',
        } only %}
    </div>
{% endif %}

{# ---- 4. Oppskrifter ------------------------------------------------------ #}
{# Uten et token er det ingenting å koble til med, og oppskriftene ville bare
   vist en plassholder. Lukket til vanlig; åpen rett etter opprettelse, som er
   det ene øyeblikket de er ferdig utfylt. #}
{% if isCurrentUser and hasAccess and (newToken or tokens is not empty) %}
    <details class="pane mcp-connect"{{ newToken ? ' open' }}>
        <summary><h2>Koble til din egen AI</h2></summary>

        <p class="light">
            {% if newToken %}
                Velg hvilken AI-assistent du vil sette opp.
            {% else %}
                Velg hvilken AI-assistent du vil sette opp. Bytt ut <code>&lt;token&gt;</code> med et token — tokenet vises bare én gang, så lag et nytt over om du ikke har det lenger.
            {% endif %}
        </p>

        <div class="mcp-tabs" role="tablist">
            {% for key, recipe in recipes %}
                <button type="button" class="btn small mcp-tab{{ loop.first ? ' is-active' }}" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-tab="{{ key }}"{% if recipe.unavailable ?? false %} title="Støttes ikke ennå"{% endif %}>
                    {%- if recipe.unavailable ?? false %}<s>{{ recipe.label }}</s><span class="visually-hidden"> (støttes ikke ennå)</span>{% else %}{{ recipe.label }}{% endif -%}
                </button>
            {% endfor %}
        </div>

        {% for key, recipe in recipes %}
            <div class="mcp-panel" role="tabpanel" data-panel="{{ key }}"{{ loop.first ? '' : ' hidden' }}>
                <p class="light">{{ recipe.help }}</p>
                {% for field in recipe.fields %}
                    {% set fieldId = 'mcp-' ~ key ~ '-' ~ loop.index %}
                    <div class="field">
                        <div class="heading"><label for="{{ fieldId }}">{{ field.label }}</label></div>
                        {% if "\n" in field.value %}
                            <div class="mcp-codeblock">
                                <textarea id="{{ fieldId }}" class="text code fullwidth" rows="{{ field.value|split("\n")|length }}" readonly>{{ field.value }}</textarea>
                                <button type="button" class="btn small mcp-copy" data-icon="clipboard" data-target="{{ fieldId }}">Kopier</button>
                            </div>
                        {% else %}
                            {% include '_includes/forms/copytext.twig' with {
                                id: fieldId,
                                value: field.value,
                                class: 'code fullwidth',
                            } only %}
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}

    </details>
{% endif %}

{# ---- 5. Tokenlista ------------------------------------------------------- #}
{% if hasAccess or tokens is not empty %}
    <h2>{{ isCurrentUser ? 'Mine tokens' : 'Tokens' }}</h2>

    {% if tokens is empty %}
        <p class="zilch small">{{ isCurrentUser ? 'Du har ingen aktive tokens ennå.' : 'Brukeren har ingen aktive tokens.' }}</p>
    {% else %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th>Navn</th>
                    <th>Sist brukt</th>
                    <th>Utløper</th>
                    <th>Opprettet</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in tokens %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td>{{ row.lastUsedAt ? row.lastUsedAt|date('short') ~ ' ' ~ row.lastUsedAt|time('short') : '—' }}</td>
                        <td>{{ row.expiresAt ? row.expiresAt|date('short') : 'aldri' }}</td>
                        <td>{{ row.dateCreated|date('short') }}</td>
                        <td class="thin">
                            <form method="post" accept-charset="UTF-8">
                                {{ csrfInput() }}
                                {{ actionInput(moduleId ~ '/tokens/revoke') }}
                                {{ hiddenInput('userId', user.id) }}
                                {{ hiddenInput('id', row.id) }}
                                <button type="submit" class="btn small">Trekk tilbake</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endif %}

<style>
    .mcp-access-form { display: flex; gap: 16px; align-items: center; justify-content: space-between; }
    .mcp-access-form p { margin: 4px 0 0; }
    .mcp-create { display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap; }
    .mcp-create > .field { margin: 0; }
    .mcp-create > .field:first-of-type { flex: 1; min-width: 240px; }
    .mcp-new-token { border-left: 4px solid var(--enabled-color, #27ab83); }
    .mcp-connect > summary { cursor: pointer; list-style: revert; }
    .mcp-connect > summary h2 { display: inline; margin: 0; }
    .mcp-tabs { display: flex; gap: 4px; margin: 14px 0; flex-wrap: wrap; }
    .mcp-tab.is-active { background: var(--gray-200); font-weight: 600; }
    .mcp-tab s { opacity: .7; }
    .mcp-codeblock { position: relative; }
    .mcp-codeblock textarea { padding-right: 90px; resize: vertical; }
    .mcp-codeblock .mcp-copy { position: absolute; top: 8px; right: 8px; }
</style>
<script>
    (function() {
        var tabs = document.querySelectorAll('.mcp-tab');
        var panels = document.querySelectorAll('.mcp-panel');
        tabs.forEach(function(tab) {
            tab.addEventListener('click', function() {
                tabs.forEach(function(t) {
                    t.classList.toggle('is-active', t === tab);
                    t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
                });
                panels.forEach(function(panel) {
                    panel.hidden = panel.dataset.panel !== tab.dataset.tab;
                });
            });
        });

        document.querySelectorAll('.mcp-copy').forEach(function(btn) {
            btn.addEventListener('click', function() {
                navigator.clipboard.writeText(document.getElementById(btn.dataset.target).value).then(function() {
                    if (window.Craft && Craft.cp) {
                        Craft.cp.displayNotice('Kopiert til utklippstavlen.');
                    }
                });
            });
        });
    })();
</script>
