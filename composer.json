{
    "name": "mustasj/craft-mcp-server",
    "description": "MCP-server for Craft CMS 5 — eksponerer innhold over Model Context Protocol med token-autentisering.",
    "type": "library",
    "license": "MIT",
    "keywords": ["craftcms", "craft-cms", "mcp", "model-context-protocol", "ai"],
    "support": {
        "issues": "https://github.com/mustasj-as/craft-mcp-server/issues",
        "source": "https://github.com/mustasj-as/craft-mcp-server"
    },
    "authors": [
        {
            "name": "Mustasj AS",
            "homepage": "https://mustasj.no"
        }
    ],
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0",
        "illuminate/collections": "^10.42",
        "mcp/sdk": "^0.4",
        "nesbot/carbon": "^2.72",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/finder": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Mustasj\\CraftMcp\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
